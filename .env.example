# Supabase 連線憑證
# 請將本檔案命名為 .env.local 並填入您專屬的專案 URL 與 Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Service Role Key (伺服器端專用，用來繞過 RLS 的管理員密鑰)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Gemini API 金鑰 (請至 Google AI Studio 申請)
GEMINI_API_KEY=your-gemini-api-key-here

# SMTP 電子郵件寄送設定 (以 Gmail 應用程式密碼為例)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM_NAME=Aether Blog AI 助手
